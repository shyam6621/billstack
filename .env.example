# Frontend environment variables (Vite)
# Copy to .env.local for local overrides

# Backend API base URL - must include /api suffix
# Local dev: http://localhost:8080/api
# Production on Vercel: set this in Vercel Project Settings -> Environment Variables
# Example: https://billstack-api.onrender.com/api
VITE_API_URL=http://localhost:8080/api

# Backend / Render / Railway MySQL environment variables
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://HOST:PORT/railway?useSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your-password
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
SPRING_JPA_DIALECT=org.hibernate.dialect.MySQLDialect
JWT_SECRET=replace-with-at-least-32-bytes-secret
CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app